<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>local.ios.security.supervised</string>
	<key>PayloadUUID</key>
	<string>5FA028B7-AE72-49B5-8A5D-8F32D7465EC4</string>
	<key>PayloadDisplayName</key>
	<string>Supervised iPhone Security - Account Changes Allowed</string>
	<key>PayloadDescription</key>
	<string>Security hardening for an authorized supervised iPhone. Requires an administrator recovery path and scheduled app updates. Does not lock all location settings or preserve all logs.</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadRemovalDisallowed</key>
	<true/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.applicationaccess</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>local.ios.security.supervised.restrictions</string>
			<key>PayloadUUID</key>
			<string>16C78502-E9D6-42C5-BB0E-3346BF713475</string>
			<key>PayloadDisplayName</key>
			<string>Supervised iPhone Security Restrictions</string>
			<key>PayloadDescription</key>
			<string>Allows account changes; restricts user app installation and removal, authentication changes, unauthorized profiles, reset, selected connectivity changes, and Safari history clearing on supported iOS versions.</string>
			<key>allowAppInstallation</key>
			<false/>
			<key>allowAppRemoval</key>
			<false/>
			<key>allowSystemAppRemoval</key>
			<false/>
			<key>allowAutomaticAppDownloads</key>
			<false/>
			<key>allowAppClips</key>
			<false/>
			<key>allowMarketplaceAppInstallation</key>
			<false/>
			<key>allowWebDistributionAppInstallation</key>
			<false/>
			<key>allowAppsToBeHidden</key>
			<false/>
			<key>allowEnterpriseAppTrust</key>
			<false/>
			<key>allowUIConfigurationProfileInstallation</key>
			<false/>
			<key>allowAccountModification</key>
			<true/>
			<key>allowPasscodeModification</key>
			<false/>
			<key>allowFingerprintModification</key>
			<false/>
			<key>allowEraseContentAndSettings</key>
			<false/>
			<key>allowESIMModification</key>
			<false/>
			<key>allowESIMOutgoingTransfers</key>
			<false/>
			<key>allowCellularPlanModification</key>
			<false/>
			<key>allowAppCellularDataModification</key>
			<false/>
			<key>allowDeviceNameModification</key>
			<false/>
			<key>allowVPNCreation</key>
			<false/>
			<key>allowUntrustedTLSPrompt</key>
			<false/>
			<key>allowFilesUSBDriveAccess</key>
			<false/>
			<key>allowUnpairedExternalBootToRecovery</key>
			<false/>
			<key>allowiPhoneMirroring</key>
			<false/>
			<key>allowVideoConferencingRemoteControl</key>
			<false/>
			<key>allowPasswordSharing</key>
			<false/>
			<key>allowPasswordProximityRequests</key>
			<false/>
			<key>allowDiagnosticSubmissionModification</key>
			<false/>
			<key>allowSafariHistoryClearing</key>
			<false/>
			<key>allowSafariPrivateBrowsing</key>
			<false/>
			<key>allowRapidSecurityResponseRemoval</key>
			<false/>
			<key>allowUSBRestrictedMode</key>
			<true/>
			<key>forceAutomaticDateAndTime</key>
			<true/>
			<key>forceEncryptedBackup</key>
			<true/>
			<key>forceAuthenticationBeforeAutoFill</key>
			<true/>
			<key>safariForceFraudWarning</key>
			<true/>
			<key>allowRapidSecurityResponseInstallation</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
